{
  "name": "nice-crochet",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:clean": "bash scripts/start-dev.sh",
    "build": "tsx scripts/validate-catalog.ts && next build",
    "start": "next start",
    "validate": "tsx scripts/validate-catalog.ts",
    "build:images": "bash scripts/build-images.sh",
    "gas:push": "cd scripts/apps-script && clasp push",
    "gas:deploy": "cd scripts/apps-script && clasp push && clasp deploy",
    "gas:open": "cd scripts/apps-script && clasp open",
    "gas:logs": "cd scripts/apps-script && clasp logs",
    "changelog": "git cliff -o CHANGELOG.md"
  },
  "dependencies": {
    "next": "^15.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
