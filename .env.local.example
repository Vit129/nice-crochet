# Copy to .env.local for local dev. Optional — leave unset and the site works
# fully, just without click tracking / sort-by-popularity, and without live
# Sheet-driven showOnShelf/showOnHome overrides (falls back to products.json).
# Setup: scripts/apps-script/click-tracking.gs
# Same URL/token serves both click tracking (?action=counts/click) and
# product visibility flags (?action=flags) — one Apps Script deployment.
NEXT_PUBLIC_CLICK_TRACKING_URL=
NEXT_PUBLIC_CLICK_TRACKING_TOKEN=
